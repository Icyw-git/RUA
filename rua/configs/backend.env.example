# Source a PRIVATE copy; do not commit real credentials.
# Anthropic-compatible messages endpoint; no internal proxy is required.
export RUA_API_BASE="https://api.anthropic.com"
export RUA_AUTH_SCHEME="x-api-key"
# Use RUA_AUTH_SCHEME=bearer for gateways that expect Authorization: Bearer.
export RUA_MODEL="REPLACE_WITH_YOUR_AVAILABLE_OPUS_MODEL_ID"
export ANTHROPIC_AUTH_TOKEN="REPLACE_WITH_YOUR_PRIVATE_TOKEN"
# One physical GPU index or UUID. Baseline admission reserves are not disabled.
export RUA_GPU=0
# Optional stricter identity binding:
# export RUA_GPU_UUID="GPU-REPLACE_WITH_YOUR_GPU_UUID"
# Default data root: parent of the WLA checkout. Optional explicit locations:
# export RUA_ROOT="/absolute/path/to/experiment-data"
# export RUA_RUNTIME="/absolute/path/to/runtime/wla-libero"
# export RUA_VENV_PYTHON="/absolute/path/to/venv/bin/python"
# export RUA_OSMESA_LIB_DIR="/absolute/path/to/private/lib"
# export HF_ENDPOINT="https://hf-mirror.com"
